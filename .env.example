# .env.example – place this file at server/.env (do NOT commit actual secrets)
# Non‑sensitive defaults for local development

# Server
PORT=5000
CLIENT_URL=http://localhost:5173

# Redis (used for caching and token blacklist)
REDIS_URL=redis://localhost:6379

# Vault (local dev instance)
VAULT_ADDR=http://127.0.0.1:8200
VAULT_TOKEN=root-token

# Feature flags (default true – can be overridden in production)
RATE_LIMIT_ENABLED=true

# The following keys are intentionally omitted – they will be injected from Vault at runtime:
# MONGODB_URI
# JWT_SECRET
# JWT_REFRESH_SECRET
# ENCRYPTION_KEY
# CLOUDINARY_CLOUD_NAME
# CLOUDINARY_API_KEY
# CLOUDINARY_API_SECRET
# EMAIL_HOST
# EMAIL_PORT
# EMAIL_USER
# EMAIL_PASSWORD
# EMAIL_FROM
